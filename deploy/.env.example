# Copie este arquivo para deploy/.env e defina DOMAIN com o IP público da
# sua VM Oracle (ex: 203.0.113.10). Sem domínio? Basta usar o IP — o acesso
# é via http://<IP> (nenhum HTTPS/certificado necessário).
DOMAIN=IP_PUBLICO_DA_VM

# Tempo de vida das salas e da mídia efêmera (após ser visualizada)
ROOM_TTL=24h
EPHEMERAL_TTL=15s

# Upload máximo: bytes (backend Go) e tamanho no nginx
MAX_UPLOAD_BYTES=52428800
NGINX_MAX_BODY=50m
